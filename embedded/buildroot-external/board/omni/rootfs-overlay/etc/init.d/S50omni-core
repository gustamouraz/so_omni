#!/bin/sh
PIDFILE=/run/omni-core.pid
RUNDIR=/run/omni
case "$1" in
  start)
    printf 'Starting omni-core: '
    mkdir -p "$RUNDIR"
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /usr/bin/omni-core -- "$RUNDIR/commands" "$RUNDIR/state.json"
    echo OK
    ;;
  stop)
    printf 'Stopping omni-core: '
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE" "$RUNDIR/commands"
    echo OK
    ;;
  restart) "$0" stop; "$0" start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
